APP_NAME="PPID BKK Pontianak"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ppid.bkkpontianak.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database KHUSUS PPID (terpisah dari database website utama)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppid
DB_USERNAME=root
DB_PASSWORD=

# Session & cache pakai file supaya tidak menambah query ke database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Alamat website utama (untuk tombol "Website BKK" dan tautan WBS / Survei)
PPID_MAIN_SITE_URL=https://bkkpontianak.com
